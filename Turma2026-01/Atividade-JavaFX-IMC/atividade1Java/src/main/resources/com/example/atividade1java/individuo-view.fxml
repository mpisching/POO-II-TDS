<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.atividade1java.controller.IndividuoController">
   <children>
      <AnchorPane layoutY="-1.0" prefHeight="407.0" prefWidth="601.0">
         <children>
